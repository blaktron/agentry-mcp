# The two sites a release can be for, committed and the same on main and dev
# scripts/release-registry.sh picks one by the released commit's first-parent
# history: a commit on main's line is a production release, one on dev's a dev
# release, anything else is refused. This server bakes neither: it drives the
# person's own agentry CLI, whose release bakes its registry, so the chosen
# site only names the channel (BUILD-INFO's channel=, the page that lists the
# bundle).
AGENTRY_REGISTRY_PRODUCTION=https://secureagentry.net
AGENTRY_REGISTRY_DEV=https://dev.secureagentry.net
